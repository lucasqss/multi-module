<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>multi-module-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!-- Módulo de montagem: nenhuma classe Java. Junta command + query no ÚNICO artefato de deploy,
         target/biblioteca.jar (uber-jar; veja application.properties), e abriga o que precisa enxergar todos os
         módulos: os testes ponta a ponta contra o jar (*IT) e as regras de arquitetura entre módulos (ArchUnit).
         Não tem classes de produção, então não tem relatório de cobertura. -->
    <artifactId>biblioteca-app</artifactId>

    <properties>
        <!-- Sem classes de produção: nada a medir (sem isso sairia um relatório vazio em target/site/jacoco/) -->
        <jacoco.skip>true</jacoco.skip>
    </properties>

    <dependencies>
        <!-- Módulos internos: sem versão, gerenciada no POM pai. Todo módulo precisa chegar até aqui (direta ou
             transitivamente): é o que o coloca no jar e nas regras do ArchUnit. -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>biblioteca-command</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>biblioteca-query</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-oracle</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
            <!-- Ativa os *IT (configurados no POM pai): ponta a ponta contra target/biblioteca.jar, fora da cobertura -->
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
