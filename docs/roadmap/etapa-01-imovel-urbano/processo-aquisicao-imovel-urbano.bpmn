<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Etapa01" targetNamespace="http://bpmn.io/schema/bpmn" exporter="gerar_bpmn.py" exporterVersion="1.0"><bpmn:collaboration id="Defs_Etapa01_collab"><bpmn:participant id="Proc_AquisicaoImovelUrbano_part" name="Etapa 1 — Aquisição de imóvel urbano pronto com a carta de crédito" processRef="Proc_AquisicaoImovelUrbano" /></bpmn:collaboration><bpmn:process id="Proc_AquisicaoImovelUrbano" name="Etapa 1 — Aquisição de imóvel urbano pronto com a carta de crédito" isExecutable="false"><bpmn:documentation>Escopo da etapa 1: imóvel urbano construído e averbado, residencial ou comercial, pagamento à vista ao vendedor, carta + recursos próprios. FGTS, planta/construção/reforma e quitação de financiamento ficam para etapas seguintes.</bpmn:documentation><bpmn:laneSet id="Proc_AquisicaoImovelUrbano_ls"><bpmn:lane id="Proc_AquisicaoImovelUrbano_L_cons" name="Consorciado"><bpmn:flowNodeRef>Tk_Abrir</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Formal</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_DocsComp</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Pend</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Compl</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Seguro</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_ITBI</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Sobra</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_AquisicaoImovelUrbano_L_vend" name="Vendedor"><bpmn:flowNodeRef>Tk_DocsVend</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Posse</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_AquisicaoImovelUrbano_L_atd" name="Administradora · Atendimento"><bpmn:flowNodeRef>St</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Elegib</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Fim</bpmn:flowNodeRef><bpmn:flowNodeRef>En</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_AquisicaoImovelUrbano_L_cred" name="Administradora · Crédito e PLD"><bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Capac</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_KYC</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Res</bpmn:flowNodeRef><bpmn:flowNodeRef>En_Rep</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_AquisicaoImovelUrbano_L_form" name="Administradora · Formalização, Jurídico e Engenharia"><bpmn:flowNodeRef>Tk_Vistoria</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Jur</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Compl</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_M1</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Redigir</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Assinar</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Protoc</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Exig</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Exig</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Conferir</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_PreCond</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_AquisicaoImovelUrbano_L_tes" name="Administradora · Tesouraria"><bpmn:flowNodeRef>Tk_Aprovar</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Pagar</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Sobra</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_M2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_AquisicaoImovelUrbano_L_ext" name="Cartório de RI · Prefeitura · Seguradora"><bpmn:flowNodeRef>Tk_Apolice</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Registro</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="St" name="Crédito disponibilizado"><bpmn:documentation>Pré-requisito: UC14 (D+3 úteis).</bpmn:documentation><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Tk_Abrir" name="Abrir processo: indicar imóvel, vendedor e valor"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f1</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f2</bpmn:outgoing></bpmn:userTask><bpmn:businessRuleTask id="Tk_Elegib" name="Validar elegibilidade do imóvel e da finalidade"><bpmn:documentation>Grupo de imóveis; imóvel urbano pronto; finalidade habilitada (PAR-07); área de atuação se CIRC_3432 (RN-23).</bpmn:documentation><bpmn:incoming>Proc_AquisicaoImovelUrbano_f2</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f3</bpmn:outgoing></bpmn:businessRuleTask><bpmn:userTask id="Tk_Formal" name="Confirmar comunicação formal"><bpmn:documentation>Res. 285 art. 18 §2º I. Inicia o prazo de análise (PAR-06).</bpmn:documentation><bpmn:incoming>Proc_AquisicaoImovelUrbano_f3</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f4</bpmn:outgoing></bpmn:userTask><bpmn:parallelGateway id="Gw_Split" name=""><bpmn:incoming>Proc_AquisicaoImovelUrbano_f4</bpmn:incoming><bpmn:incoming>Proc_AquisicaoImovelUrbano_f18</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f5</bpmn:outgoing><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f6</bpmn:outgoing><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f7</bpmn:outgoing></bpmn:parallelGateway><bpmn:userTask id="Tk_DocsComp" name="Enviar documentos pessoais e de renda"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f5</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f8</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Tk_DocsVend" name="Enviar documentos do vendedor e do imóvel"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f6</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f9</bpmn:outgoing></bpmn:userTask><bpmn:task id="Tk_Vistoria" name="Vistoriar e emitir laudo de avaliação"><bpmn:documentation>[PRÁTICA] RP-02; define o valor avaliado.</bpmn:documentation><bpmn:incoming>Proc_AquisicaoImovelUrbano_f7</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f13</bpmn:outgoing></bpmn:task><bpmn:businessRuleTask id="Tk_Capac" name="Analisar capacidade de pagamento"><bpmn:documentation>RN-05; evidência guardada 5 anos após o encerramento.</bpmn:documentation><bpmn:incoming>Proc_AquisicaoImovelUrbano_f8</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f11</bpmn:outgoing></bpmn:businessRuleTask><bpmn:businessRuleTask id="Tk_KYC" name="Qualificar vendedor (KYC/PLD)"><bpmn:documentation>UC23; RN-19.</bpmn:documentation><bpmn:incoming>Proc_AquisicaoImovelUrbano_f9</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f10</bpmn:outgoing></bpmn:businessRuleTask><bpmn:businessRuleTask id="Tk_Jur" name="Analisar matrícula, ônus e certidões"><bpmn:documentation>Construção averbada; ausência de ônus impeditivos; certidões do vendedor e do imóvel [PRÁTICA].</bpmn:documentation><bpmn:incoming>Proc_AquisicaoImovelUrbano_f10</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f12</bpmn:outgoing></bpmn:businessRuleTask><bpmn:parallelGateway id="Gw_Join" name=""><bpmn:incoming>Proc_AquisicaoImovelUrbano_f11</bpmn:incoming><bpmn:incoming>Proc_AquisicaoImovelUrbano_f12</bpmn:incoming><bpmn:incoming>Proc_AquisicaoImovelUrbano_f13</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f14</bpmn:outgoing></bpmn:parallelGateway><bpmn:exclusiveGateway id="Gw_Res" name="Resultado das análises?"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f14</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f15</bpmn:outgoing><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f16</bpmn:outgoing><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f17</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Tk_Pend" name="Sanar pendências"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f15</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f18</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="En_Rep" name="Reprovado (crédito segue disponível)"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f16</bpmn:incoming></bpmn:endEvent><bpmn:exclusiveGateway id="Gw_Compl" name="Valor do imóvel &gt; carta?"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f17</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f19</bpmn:outgoing><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f20</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Tk_Compl" name="Comprovar recursos próprios do complemento"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f19</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f21</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gw_M1" name=""><bpmn:incoming>Proc_AquisicaoImovelUrbano_f20</bpmn:incoming><bpmn:incoming>Proc_AquisicaoImovelUrbano_f21</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f22</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Tk_Seguro" name="Aderir aos seguros exigidos"><bpmn:documentation>[CONTRATO]/[PRÁTICA]: ex. danos físicos ao imóvel; prestamista.</bpmn:documentation><bpmn:incoming>Proc_AquisicaoImovelUrbano_f22</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f23</bpmn:outgoing></bpmn:userTask><bpmn:task id="Tk_Apolice" name="Emitir apólice / certificado"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f23</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f24</bpmn:outgoing></bpmn:task><bpmn:task id="Tk_Redigir" name="Redigir instrumento de compra e venda com alienação fiduciária"><bpmn:documentation>Instrumento particular com efeito de escritura (Lei 11.795 art. 45 p.u.; Lei 9.514 art. 38).</bpmn:documentation><bpmn:incoming>Proc_AquisicaoImovelUrbano_f24</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f25</bpmn:outgoing></bpmn:task><bpmn:userTask id="Tk_Assinar" name="Colher assinaturas (comprador, cônjuge, vendedor, administradora)"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f25</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f26</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Tk_ITBI" name="Emitir guia e pagar ITBI"><bpmn:documentation>Reembolsável depois pela sobra, dentro do teto de 10% (RN-16).</bpmn:documentation><bpmn:incoming>Proc_AquisicaoImovelUrbano_f26</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f27</bpmn:outgoing></bpmn:userTask><bpmn:task id="Tk_Protoc" name="Protocolar no Registro de Imóveis (prenotação)"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f27</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f28</bpmn:outgoing></bpmn:task><bpmn:task id="Tk_Registro" name="Qualificar título e registrar compra e venda + AF"><bpmn:documentation>Ato único para emolumentos (Lei 11.795 art. 45).</bpmn:documentation><bpmn:incoming>Proc_AquisicaoImovelUrbano_f28</bpmn:incoming><bpmn:incoming>Proc_AquisicaoImovelUrbano_f32</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f29</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="Gw_Exig" name="Nota de exigência?"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f29</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f30</bpmn:outgoing><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f31</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Tk_Exig" name="Cumprir exigência no prazo da prenotação"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f30</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f32</bpmn:outgoing></bpmn:userTask><bpmn:businessRuleTask id="Tk_Conferir" name="Conferir matrícula: propriedade e AF a favor do grupo"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f31</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f33</bpmn:outgoing></bpmn:businessRuleTask><bpmn:businessRuleTask id="Tk_PreCond" name="Validar pré-condições de pagamento (art. 18 §2º)"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f33</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f34</bpmn:outgoing></bpmn:businessRuleTask><bpmn:userTask id="Tk_Aprovar" name="Preparar e aprovar pagamento (quatro olhos)"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f34</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f35</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Tk_Pagar" name="Pagar vendedor (descontado sinal ressarcível)"><bpmn:documentation>RN-06; RN-22.</bpmn:documentation><bpmn:incoming>Proc_AquisicaoImovelUrbano_f35</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f36</bpmn:outgoing></bpmn:serviceTask><bpmn:task id="Tk_Posse" name="Receber pagamento e entregar posse/chaves"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f36</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f37</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="Gw_Sobra" name="Sobrou crédito?"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f37</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f38</bpmn:outgoing><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f39</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Tk_Sobra" name="Escolher destinação da sobra"><bpmn:documentation>Despesas ≤ 10% (ITBI, registro, seguros); vincendas; devolução com quitação.</bpmn:documentation><bpmn:incoming>Proc_AquisicaoImovelUrbano_f38</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f40</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gw_M2" name=""><bpmn:incoming>Proc_AquisicaoImovelUrbano_f39</bpmn:incoming><bpmn:incoming>Proc_AquisicaoImovelUrbano_f40</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f41</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="Tk_Fim" name="Registrar crédito utilizado e arquivar dossiê"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f41</bpmn:incoming><bpmn:outgoing>Proc_AquisicaoImovelUrbano_f42</bpmn:outgoing></bpmn:task><bpmn:endEvent id="En" name="Imóvel adquirido e garantia registrada"><bpmn:incoming>Proc_AquisicaoImovelUrbano_f42</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Proc_AquisicaoImovelUrbano_f1" name="" sourceRef="St" targetRef="Tk_Abrir" /><bpmn:sequenceFlow id="Proc_AquisicaoImovelUrbano_f2" name="" sourceRef="Tk_Abrir" targetRef="Tk_Elegib" /><bpmn:sequenceFlow id="Proc_AquisicaoImovelUrbano_f3" name="" sourceRef="Tk_Elegib" targetRef="Tk_Formal" /><bpmn:sequenceFlow id="Proc_AquisicaoImovelUrbano_f4" name="" sourceRef="Tk_Formal" targetRef="Gw_Split" /><bpmn:sequenceFlow id="Proc_AquisicaoImovelUrbano_f5" name="" sourceRef="Gw_Split" targetRef="Tk_DocsComp" /><bpmn:sequenceFlow id="Proc_AquisicaoImovelUrbano_f6" name="" sourceRef="Gw_Split" targetRef="Tk_DocsVend" /><bpmn:sequenceFlow id="Proc_AquisicaoImovelUrbano_f7" name="" sourceRef="Gw_Split" targetRef="Tk_Vistoria" /><bpmn:sequenceFlow id="Proc_AquisicaoImovelUrbano_f8" name=