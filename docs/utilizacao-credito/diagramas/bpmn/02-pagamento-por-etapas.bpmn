<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Etapas" targetNamespace="http://bpmn.io/schema/bpmn" exporter="gerar_bpmn.py" exporterVersion="1.0"><bpmn:collaboration id="Defs_Etapas_collab"><bpmn:participant id="Proc_PagamentoEtapas_part" name="Pagamento por etapas (planta, construção, reforma, serviço por cronograma)" processRef="Proc_PagamentoEtapas" /></bpmn:collaboration><bpmn:process id="Proc_PagamentoEtapas" name="Pagamento por etapas (planta, construção, reforma, serviço por cronograma)" isExecutable="false"><bpmn:documentation>Saldo não liberado permanece aplicado e rendendo (Res. 285 art. 17). Enquanto o bem não existe, a garantia é alternativa (Lei 11.795 art. 14 §3º) e deve ser substituída na conclusão (art. 2º XV).</bpmn:documentation><bpmn:laneSet id="Proc_PagamentoEtapas_ls"><bpmn:lane id="Proc_PagamentoEtapas_L_cons" name="Consorciado"><bpmn:flowNodeRef>Tk_Autorizar</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_PagamentoEtapas_L_eng" name="Administradora · Engenharia/Formalização"><bpmn:flowNodeRef>St</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Adiant</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Contrato</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_M1</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Vistoriar</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Conforme</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Ultima</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Imovel</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Substituir</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_M2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_PagamentoEtapas_L_tes" name="Administradora · Tesouraria"><bpmn:flowNodeRef>Tk_PagAdiant</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Liberar</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Retencao</bpmn:flowNodeRef><bpmn:flowNodeRef>En</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_PagamentoEtapas_L_forn" name="Construtora / Prestador"><bpmn:flowNodeRef>Tk_Executar</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Solicitar</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Entregar</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="St" name="Cronograma físico-financeiro aprovado"><bpmn:outgoing>Proc_PagamentoEtapas_f1</bpmn:outgoing></bpmn:startEvent><bpmn:exclusiveGateway id="Gw_Adiant" name="Há adiantamento antes da execução?"><bpmn:incoming>Proc_PagamentoEtapas_f1</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f2</bpmn:outgoing><bpmn:outgoing>Proc_PagamentoEtapas_f3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Tk_Contrato" name="Formalizar contrato fornecedor × administradora"><bpmn:documentation>[NORMA] Res. 285 art. 18 §2º II: a administradora assume total responsabilidade pelo adiantamento.</bpmn:documentation><bpmn:incoming>Proc_PagamentoEtapas_f2</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f4</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Tk_PagAdiant" name="Pagar adiantamento"><bpmn:incoming>Proc_PagamentoEtapas_f4</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f5</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gw_M1" name=""><bpmn:incoming>Proc_PagamentoEtapas_f3</bpmn:incoming><bpmn:incoming>Proc_PagamentoEtapas_f5</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="Tk_Executar" name="Executar etapa"><bpmn:incoming>Proc_PagamentoEtapas_f6</bpmn:incoming><bpmn:incoming>Proc_PagamentoEtapas_f10</bpmn:incoming><bpmn:incoming>Proc_PagamentoEtapas_f14</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f7</bpmn:outgoing></bpmn:task><bpmn:sendTask id="Tk_Solicitar" name="Solicitar medição/liberação"><bpmn:incoming>Proc_PagamentoEtapas_f7</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f8</bpmn:outgoing></bpmn:sendTask><bpmn:userTask id="Tk_Vistoriar" name="Vistoriar e medir etapa"><bpmn:documentation>[PRÁTICA] laudo de medição.</bpmn:documentation><bpmn:incoming>Proc_PagamentoEtapas_f8</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f9</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gw_Conforme" name="Etapa conforme?"><bpmn:incoming>Proc_PagamentoEtapas_f9</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f10</bpmn:outgoing><bpmn:outgoing>Proc_PagamentoEtapas_f11</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Tk_Autorizar" name="Autorizar liberação da parcela"><bpmn:incoming>Proc_PagamentoEtapas_f11</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f12</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Tk_Liberar" name="Liberar parcela ao fornecedor"><bpmn:documentation>Pagamento direto ao fornecedor (art. 18 caput). Retenção final é [PRÁTICA].</bpmn:documentation><bpmn:incoming>Proc_PagamentoEtapas_f12</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f13</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gw_Ultima" name="Última etapa?"><bpmn:incoming>Proc_PagamentoEtapas_f13</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f14</bpmn:outgoing><bpmn:outgoing>Proc_PagamentoEtapas_f15</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="Tk_Entregar" name="Entregar obra/serviço (habite-se, averbação, NF)"><bpmn:incoming>Proc_PagamentoEtapas_f15</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f16</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="Gw_Imovel" name="Objeto é imóvel?"><bpmn:incoming>Proc_PagamentoEtapas_f16</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f17</bpmn:outgoing><bpmn:outgoing>Proc_PagamentoEtapas_f18</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Tk_Substituir" name="Substituir garantia provisória pela AF do imóvel"><bpmn:documentation>[CONTRATO] Res. 285 art. 2º XV (procedimento de substituição); Lei 11.795 art. 14 §5º I.</bpmn:documentation><bpmn:incoming>Proc_PagamentoEtapas_f17</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f19</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gw_M2" name=""><bpmn:incoming>Proc_PagamentoEtapas_f18</bpmn:incoming><bpmn:incoming>Proc_PagamentoEtapas_f19</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f20</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Tk_Retencao" name="Liberar retenção final"><bpmn:incoming>Proc_PagamentoEtapas_f20</bpmn:incoming><bpmn:outgoing>Proc_PagamentoEtapas_f21</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="En" name="Pagamento por etapas concluído"><bpmn:incoming>Proc_PagamentoEtapas_f21</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f1" name="" sourceRef="St" targetRef="Gw_Adiant" /><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f2" name="sim" sourceRef="Gw_Adiant" targetRef="Tk_Contrato" /><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f3" name="não" sourceRef="Gw_Adiant" targetRef="Gw_M1" /><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f4" name="" sourceRef="Tk_Contrato" targetRef="Tk_PagAdiant" /><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f5" name="" sourceRef="Tk_PagAdiant" targetRef="Gw_M1" /><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f6" name="" sourceRef="Gw_M1" targetRef="Tk_Executar" /><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f7" name="" sourceRef="Tk_Executar" targetRef="Tk_Solicitar" /><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f8" name="" sourceRef="Tk_Solicitar" targetRef="Tk_Vistoriar" /><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f9" name="" sourceRef="Tk_Vistoriar" targetRef="Gw_Conforme" /><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f10" name="não" sourceRef="Gw_Conforme" targetRef="Tk_Executar" /><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f11" name="sim" sourceRef="Gw_Conforme" targetRef="Tk_Autorizar" /><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f12" name="" sourceRef="Tk_Autorizar" targetRef="Tk_Liberar" /><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f13" name="" sourceRef="Tk_Liberar" targetRef="Gw_Ultima" /><bpmn:sequenceFlow id="Proc_PagamentoEtapas_f14" name="não" sourceRef="Gw_Ultima" targetRef="Tk_Executar" /><b