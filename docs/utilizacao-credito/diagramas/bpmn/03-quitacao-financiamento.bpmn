<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Quitacao" targetNamespace="http://bpmn.io/schema/bpmn" exporter="gerar_bpmn.py" exporterVersion="1.0"><bpmn:collaboration id="Defs_Quitacao_collab"><bpmn:participant id="Proc_QuitacaoFinanciamento_part" name="Quitação de financiamento próprio com a carta de crédito" processRef="Proc_QuitacaoFinanciamento" /></bpmn:collaboration><bpmn:process id="Proc_QuitacaoFinanciamento" name="Quitação de financiamento próprio com a carta de crédito" isExecutable="false"><bpmn:documentation>Res. 285 art. 15 II e §1º (inclui arrendamento financeiro e consórcio já utilizado); Lei 11.795 art. 22 §3º. Janela de risco: entre o pagamento ao credor e o registro da nova garantia o grupo fica descoberto.</bpmn:documentation><bpmn:laneSet id="Proc_QuitacaoFinanciamento_ls"><bpmn:lane id="Proc_QuitacaoFinanciamento_L_cons" name="Consorciado"><bpmn:flowNodeRef>Tk_Aporte</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_QuitacaoFinanciamento_L_form" name="Administradora · Formalização/Garantias"><bpmn:flowNodeRef>St</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Validar</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Saldo</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_M1</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_PreCond</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Evt</bpmn:flowNodeRef><bpmn:flowNodeRef>Ev_Termo</bpmn:flowNodeRef><bpmn:flowNodeRef>Ev_Prazo</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Escalar</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Constituir</bpmn:flowNodeRef><bpmn:flowNodeRef>Tk_Fechar</bpmn:flowNodeRef><bpmn:flowNodeRef>En</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_QuitacaoFinanciamento_L_tes" name="Administradora · Tesouraria"><bpmn:flowNodeRef>Tk_Pagar</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_QuitacaoFinanciamento_L_cred" name="Credor original"><bpmn:flowNodeRef>Tk_Saldo</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_QuitacaoFinanciamento_L_reg" name="Registros (Detran/SNG, RI)"><bpmn:flowNodeRef>Tk_Registro</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="St" name="Quitação aprovada (anuência prévia)"><bpmn:outgoing>Proc_QuitacaoFinanciamento_f1</bpmn:outgoing></bpmn:startEvent><bpmn:businessRuleTask id="Tk_Validar" name="Validar titularidade, mesma categoria e quitação total"><bpmn:documentation>[NORMA] art. 15 II: quitação TOTAL, financiamento de titularidade do consorciado, mesma categoria.</bpmn:documentation><bpmn:incoming>Proc_QuitacaoFinanciamento_f1</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f2</bpmn:outgoing></bpmn:businessRuleTask><bpmn:task id="Tk_Saldo" name="Obter saldo de quitação com validade"><bpmn:incoming>Proc_QuitacaoFinanciamento_f2</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f3</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="Gw_Saldo" name="Saldo &gt; crédito disponível?"><bpmn:incoming>Proc_QuitacaoFinanciamento_f3</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f4</bpmn:outgoing><bpmn:outgoing>Proc_QuitacaoFinanciamento_f5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Tk_Aporte" name="Aportar recursos próprios"><bpmn:documentation>Registrar composição de recursos (PLD).</bpmn:documentation><bpmn:incoming>Proc_QuitacaoFinanciamento_f4</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f6</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gw_M1" name=""><bpmn:incoming>Proc_QuitacaoFinanciamento_f5</bpmn:incoming><bpmn:incoming>Proc_QuitacaoFinanciamento_f6</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:businessRuleTask id="Tk_PreCond" name="Validar pré-condições de pagamento (art. 18 §2º)"><bpmn:documentation>[NORMA] Res. 285 art. 18 §2º: identificação do credor, condições e documentos antes do pagamento.</bpmn:documentation><bpmn:incoming>Proc_QuitacaoFinanciamento_f7</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f8</bpmn:outgoing></bpmn:businessRuleTask><bpmn:serviceTask id="Tk_Pagar" name="Pagar credor original (nunca o consorciado)"><bpmn:incoming>Proc_QuitacaoFinanciamento_f8</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f9</bpmn:outgoing></bpmn:serviceTask><bpmn:eventBasedGateway id="Gw_Evt" name=""><bpmn:incoming>Proc_QuitacaoFinanciamento_f9</bpmn:incoming><bpmn:incoming>Proc_QuitacaoFinanciamento_f13</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f10</bpmn:outgoing><bpmn:outgoing>Proc_QuitacaoFinanciamento_f11</bpmn:outgoing></bpmn:eventBasedGateway><bpmn:intermediateCatchEvent id="Ev_Termo" name="Termo de quitação e baixa do gravame recebidos"><bpmn:incoming>Proc_QuitacaoFinanciamento_f10</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f14</bpmn:outgoing><bpmn:messageEventDefinition id="Ev_Termo_ed" /></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="Ev_Prazo" name="Prazo máximo da janela sem garantia"><bpmn:documentation>[PRÁTICA] parametrizável.</bpmn:documentation><bpmn:incoming>Proc_QuitacaoFinanciamento_f11</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f12</bpmn:outgoing><bpmn:timerEventDefinition id="Ev_Prazo_td"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:userTask id="Tk_Escalar" name="Cobrar credor / acionar garantia provisória"><bpmn:incoming>Proc_QuitacaoFinanciamento_f12</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f13</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Tk_Constituir" name="Constituir AF em favor do grupo"><bpmn:incoming>Proc_QuitacaoFinanciamento_f14</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f15</bpmn:outgoing></bpmn:userTask><bpmn:task id="Tk_Registro" name="Registrar nova garantia"><bpmn:incoming>Proc_QuitacaoFinanciamento_f15</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f16</bpmn:outgoing></bpmn:task><bpmn:serviceTask id="Tk_Fechar" name="Encerrar janela de risco"><bpmn:incoming>Proc_QuitacaoFinanciamento_f16</bpmn:incoming><bpmn:outgoing>Proc_QuitacaoFinanciamento_f17</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="En" name="Financiamento quitado e garantia registrada"><bpmn:incoming>Proc_QuitacaoFinanciamento_f17</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f1" name="" sourceRef="St" targetRef="Tk_Validar" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f2" name="" sourceRef="Tk_Validar" targetRef="Tk_Saldo" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f3" name="" sourceRef="Tk_Saldo" targetRef="Gw_Saldo" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f4" name="sim" sourceRef="Gw_Saldo" targetRef="Tk_Aporte" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f5" name="não" sourceRef="Gw_Saldo" targetRef="Gw_M1" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f6" name="" sourceRef="Tk_Aporte" targetRef="Gw_M1" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f7" name="" sourceRef="Gw_M1" targetRef="Tk_PreCond" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f8" name="" sourceRef="Tk_PreCond" targetRef="Tk_Pagar" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f9" name="" sourceRef="Tk_Pagar" targetRef="Gw_Evt" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f10" name="" sourceRef="Gw_Evt" targetRef="Ev_Termo" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f11" name="" sourceRef="Gw_Evt" targetRef="Ev_Prazo" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f12" name="" sourceRef="Ev_Prazo" targetRef="Tk_Escalar" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f13" name="" sourceRef="Tk_Escalar" targetRef="Gw_Evt" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f14" name="" sourceRef="Ev_Termo" targetRef="Tk_Constituir" /><bpmn:sequenceFlow id="Proc_QuitacaoFinanciamento_f15" name="" sourceRef="Tk_Co