<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Eventos" targetNamespace="http://bpmn.io/schema/bpmn" exporter="gerar_bpmn.py" exporterVersion="1.0"><bpmn:collaboration id="Defs_Eventos_collab"><bpmn:participant id="Proc_Especie_part" name="Crédito em espécie (≥ 180 dias da contemplação)" processRef="Proc_Especie" /><bpmn:participant id="Proc_Inadimplencia_part" name="Inadimplência de contemplado" processRef="Proc_Inadimplencia" /><bpmn:participant id="Proc_BaixaGarantia_part" name="Quitação da cota e baixa de garantia" processRef="Proc_BaixaGarantia" /><bpmn:participant id="Proc_Encerramento_part" name="Encerramento do grupo com crédito não utilizado" processRef="Proc_Encerramento" /></bpmn:collaboration><bpmn:process id="Proc_Especie" name="Crédito em espécie (≥ 180 dias da contemplação)" isExecutable="false"><bpmn:documentation>[NORMA] Res. 285 art. 15 §2º: 180 dias + quitação das obrigações com grupo e administradora.</bpmn:documentation><bpmn:laneSet id="Proc_Especie_ls"><bpmn:lane id="Proc_Especie_L_cons" name="Consorciado"><bpmn:flowNodeRef>Especie_Tk_Optar</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_Especie_L_adm" name="Administradora"><bpmn:flowNodeRef>Especie_St_180</bpmn:flowNodeRef><bpmn:flowNodeRef>Especie_Tk_Informar</bpmn:flowNodeRef><bpmn:flowNodeRef>Especie_Gw_Quitado</bpmn:flowNodeRef><bpmn:flowNodeRef>Especie_Gw_M</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_Especie_L_tes" name="Tesouraria"><bpmn:flowNodeRef>Especie_Tk_Abater</bpmn:flowNodeRef><bpmn:flowNodeRef>Especie_Tk_Creditar</bpmn:flowNodeRef><bpmn:flowNodeRef>Especie_En</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Especie_St_180" name="180 dias da contemplação sem utilização"><bpmn:outgoing>Proc_Especie_f1</bpmn:outgoing><bpmn:timerEventDefinition id="Especie_St_180_td"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P180D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:startEvent><bpmn:sendTask id="Especie_Tk_Informar" name="Informar opção de crédito em espécie"><bpmn:incoming>Proc_Especie_f1</bpmn:incoming><bpmn:outgoing>Proc_Especie_f2</bpmn:outgoing></bpmn:sendTask><bpmn:userTask id="Especie_Tk_Optar" name="Optar por espécie e informar conta/Pix própria"><bpmn:documentation>Res. 285 art. 2º XVI e art. 51: conta de titularidade do consorciado.</bpmn:documentation><bpmn:incoming>Proc_Especie_f2</bpmn:incoming><bpmn:outgoing>Proc_Especie_f3</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Especie_Gw_Quitado" name="Obrigações quitadas?"><bpmn:incoming>Proc_Especie_f3</bpmn:incoming><bpmn:outgoing>Proc_Especie_f4</bpmn:outgoing><bpmn:outgoing>Proc_Especie_f5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Especie_Tk_Abater" name="Quitar saldo devedor com o próprio crédito"><bpmn:documentation>[CONTRATO]/[PRÁTICA] — confirmar se o regulamento permite.</bpmn:documentation><bpmn:incoming>Proc_Especie_f4</bpmn:incoming><bpmn:outgoing>Proc_Especie_f6</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Especie_Gw_M" name=""><bpmn:incoming>Proc_Especie_f5</bpmn:incoming><bpmn:incoming>Proc_Especie_f6</bpmn:incoming><bpmn:outgoing>Proc_Especie_f7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Especie_Tk_Creditar" name="Creditar valor líquido ao consorciado"><bpmn:incoming>Proc_Especie_f7</bpmn:incoming><bpmn:outgoing>Proc_Especie_f8</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="Especie_En" name="Crédito pago em espécie"><bpmn:incoming>Proc_Especie_f8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Proc_Especie_f1" name="" sourceRef="Especie_St_180" targetRef="Especie_Tk_Informar" /><bpmn:sequenceFlow id="Proc_Especie_f2" name="" sourceRef="Especie_Tk_Informar" targetRef="Especie_Tk_Optar" /><bpmn:sequenceFlow id="Proc_Especie_f3" name="" sourceRef="Especie_Tk_Optar" targetRef="Especie_Gw_Quitado" /><bpmn:sequenceFlow id="Proc_Especie_f4" name="não" sourceRef="Especie_Gw_Quitado" targetRef="Especie_Tk_Abater" /><bpmn:sequenceFlow id="Proc_Especie_f5" name="sim" sourceRef="Especie_Gw_Quitado" targetRef="Especie_Gw_M" /><bpmn:sequenceFlow id="Proc_Especie_f6" name="" sourceRef="Especie_Tk_Abater" targetRef="Especie_Gw_M" /><bpmn:sequenceFlow id="Proc_Especie_f7" name="" sourceRef="Especie_Gw_M" targetRef="Especie_Tk_Creditar" /><bpmn:sequenceFlow id="Proc_Especie_f8" name="" sourceRef="Especie_Tk_Creditar" targetRef="Especie_En" /></bpmn:process><bpmn:process id="Proc_Inadimplencia" name="Inadimplência de contemplado" isExecutable="false"><bpmn:laneSet id="Proc_Inadimplencia_ls"><bpmn:lane id="Proc_Inadimplencia_L_cob" name="Cobrança"><bpmn:flowNodeRef>Inadimplencia_St</bpmn:flowNodeRef><bpmn:flowNodeRef>Inadimplencia_Gw_Usou</bpmn:flowNodeRef><bpmn:flowNodeRef>Inadimplencia_Gw_Atraso</bpmn:flowNodeRef><bpmn:flowNodeRef>Inadimplencia_En_Ord</bpmn:flowNodeRef><bpmn:flowNodeRef>Inadimplencia_Gw_Regime</bpmn:flowNodeRef><bpmn:flowNodeRef>Inadimplencia_Tk_Excluir</bpmn:flowNodeRef><bpmn:flowNodeRef>Inadimplencia_En_NU</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_Inadimplencia_L_jur" name="Jurídico"><bpmn:flowNodeRef>Inadimplencia_Ca_Exec</bpmn:flowNodeRef><bpmn:flowNodeRef>Inadimplencia_Tk_Alienar</bpmn:flowNodeRef><bpmn:flowNodeRef>Inadimplencia_Tk_Cobrar</bpmn:flowNodeRef><bpmn:flowNodeRef>Inadimplencia_Tk_AGO</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_Inadimplencia_L_tes" name="Tesouraria"><bpmn:flowNodeRef>Inadimplencia_Gw_Saldo</bpmn:flowNodeRef><bpmn:flowNodeRef>Inadimplencia_Tk_Devolver</bpmn:flowNodeRef><bpmn:flowNodeRef>Inadimplencia_En_Exec</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Inadimplencia_St" name="Prestação vencida não paga"><bpmn:outgoing>Proc_Inadimplencia_f1</bpmn:outgoing></bpmn:startEvent><bpmn:exclusiveGateway id="Inadimplencia_Gw_Usou" name="Crédito já utilizado?"><bpmn:incoming>Proc_Inadimplencia_f1</bpmn:incoming><bpmn:outgoing>Proc_Inadimplencia_f2</bpmn:outgoing><bpmn:outgoing>Proc_Inadimplencia_f3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="Inadimplencia_Gw_Atraso" name="Atraso &gt; 1 prestação?"><bpmn:incoming>Proc_Inadimplencia_f2</bpmn:incoming><bpmn:outgoing>Proc_Inadimplencia_f4</bpmn:outgoing><bpmn:outgoing>Proc_Inadimplencia_f5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="Inadimplencia_En_Ord" name="Cobrança ordinária"><bpmn:incoming>Proc_Inadimplencia_f4</bpmn:incoming></bpmn:endEvent><bpmn:callActivity id="Inadimplencia_Ca_Exec" name="Executar garantia (DL 911 / Lei 9.514)"><bpmn:documentation>[NORMA] Res. 285 art. 27: execução imediata. Extrajudicial (DL 911 arts. 8º-B a 8º-E) exige cláusula expressa.</bpmn:documentation><bpmn:incoming>Proc_Inadimplencia_f5</bpmn:incoming><bpmn:outgoing>Proc_Inadimplencia_f6</bpmn:outgoing></bpmn:callActivity><bpmn:task id="Inadimplencia_Tk_Alienar" name="Alienar bem e apurar saldo"><bpmn:documentation>Res. 285 art. 28.</bpmn:documentation><bpmn:incoming>Proc_Inadimplencia_f6</bpmn:incoming><bpmn:outgoing>Proc_Inadimplencia_f7</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="Inadimplencia_Gw_Saldo" name="Resultado?"><bpmn:incoming>Proc_Inadimplencia_f7</bpmn:incoming><bpmn:outgoing>Proc_Inadimplencia_f8</bpmn:outgoing><bpmn:outgoing>Proc_Inadimplencia_f9</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Inadimplencia_Tk_Devolver" name="Devolver saldo positivo ao consorciado"><bpmn:incoming>Proc_Inadimplencia_f8</bpmn:incoming><bpmn:outgoing>Proc_Inadimplencia_f10</bpmn:outgoing></bpmn:serviceTask><bpmn:task id="Inadimplencia_Tk_Cobrar" name="Cobrar saldo remanescente"><bpmn:documentation>Lei 11.795 art. 14 §6º; Lei 9.514 art. 27 §5º-A.</bpmn:documentation><bpmn:incoming>Proc_Inadimplencia_f9</bpmn:incoming><bpmn:outgoing>Proc_Inadimplencia_f11</bpmn:outgoing></bpmn:task><bpmn:endEvent id="Inadimplencia_En_Exec" name="Execução encerrada"><bpmn:incoming>Proc_Inadimplencia_f10</bpmn:incoming><bpmn:incoming>Proc_Inadimplencia_f11</bpmn:incoming></bpmn:endEvent><bpmn:exclusiveGateway id="Inadimplencia_Gw_Regime" name="Regime normativo do grupo?"><bpmn:incoming>Proc_Inadimplencia_f3</bpmn:incoming><bpmn:outgoing>Proc_Inadimplencia_f12</bpmn:outgoing><bpmn:outgoing>Proc_Inadimplencia_f13</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Inadimplencia_Tk_Excluir" name="Excluir (3 vencimentos) e calcular crédito parcial"><bpmn:documentation>Res. 285 arts. 32 II, 32-A e 33 — apenas se NÃO utilizou o crédito (art. 32 p.u.).</bpmn:documentation><bpmn:incoming>Proc_Inadimplencia_f12</bpmn:incoming><bpmn:outgoing>Proc_Inadimplencia_f14</bpmn:outgoing></bpmn:serviceTask><bpmn:task id="Inadimplencia_Tk_AGO" name="Submeter à AGO cancelamento da contemplação"><bpmn:documentation>Circ. 3.432 art. 10 (grupos antigos). Exclusão de contemplado vedada (art. 2º p.u.).</bpmn:documentation><bpmn:incoming>Proc_Inadimplencia_f13</bpmn:incoming><bpmn:outgoing>Proc_Inadimplencia_f15</bpmn:outgoing></bpmn:task><bpmn:endEvent id="Inadimplencia_En_NU" name="Tratamento de não utilizado concluído"><bpmn:incoming>Proc_Inadimplencia_f14</bpmn:incoming><bpmn:incoming>Proc_Inadimplencia_f15</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Proc_Inadimplencia_f1" name="" sourceRef="Inadimplencia_St" targetRef="Inadimplencia_Gw_Usou" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f2" name="sim" sourceRef="Inadimplencia_Gw_Usou" targetRef="Inadimplencia_Gw_Atraso" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f3" name="não" sourceRef="Inadimplencia_Gw_Usou" targetRef="Inadimplencia_Gw_Regime" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f4" name="não" sourceRef="Inadimplencia_Gw_Atraso" targetRef="Inadimplencia_En_Ord" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f5" name="sim" sourceRef="Inadimplencia_Gw_Atraso" targetRef="Inadimplencia_Ca_Exec" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f6" name="" sourceRef="Inadimplencia_Ca_Exec" targetRef="Inadimplencia_Tk_Alienar" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f7" name="" sourceRef="Inadimplencia_Tk_Alienar" targetRef="Inadimplencia_Gw_Saldo" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f8" name="positivo" sourceRef="Inadimplencia_Gw_Saldo" targetRef="Inadimplencia_Tk_Devolver" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f9" name="negativo" sourceRef="Inadimplencia_Gw_Saldo" targetRef="Inadimplencia_Tk_Cobrar" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f10" name="" sourceRef="Inadimplencia_Tk_Devolver" targetRef="Inadimplencia_En_Exec" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f11" name="" sourceRef="Inadimplencia_Tk_Cobrar" targetRef="Inadimplencia_En_Exec" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f12" name="RES_285" sourceRef="Inadimplencia_Gw_Regime" targetRef="Inadimplencia_Tk_Excluir" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f13" name="CIRC_3432" sourceRef="Inadimplencia_Gw_Regime" targetRef="Inadimplencia_Tk_AGO" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f14" name="" sourceRef="Inadimplencia_Tk_Excluir" targetRef="Inadimplencia_En_NU" /><bpmn:sequenceFlow id="Proc_Inadimplencia_f15" name="" sourceRef="Inadimplencia_Tk_AGO" targetRef="Inadimplencia_En_NU" /></bpmn:process><bpmn:process id="Proc_BaixaGarantia" name="Quitação da cota e baixa de garantia" isExecutable="false"><bpmn:laneSet id="Proc_BaixaGarantia_ls"><bpmn:lane id="Proc_BaixaGarantia_L_adm" name="Administradora · Formalização"><bpmn:flowNodeRef>BaixaGarantia_St</bpmn:flowNodeRef><bpmn:flowNodeRef>BaixaGarantia_Tk_Conferir</bpmn:flowNodeRef><bpmn:flowNodeRef>BaixaGarantia_Tk_Termo</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_BaixaGarantia_L_reg" name="Registros"><bpmn:flowNodeRef>BaixaGarantia_Tk_Baixa</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_BaixaGarantia_L_cons" name="Consorciado"><bpmn:flowNodeRef>BaixaGarantia_Tk_Recebe</bpmn:flowNodeRef><bpmn:flowNodeRef>BaixaGarantia_En</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="BaixaGarantia_St" name="Cota quitada"><bpmn:outgoing>Proc_BaixaGarantia_f1</bpmn:outgoing><bpmn:messageEventDefinition id="BaixaGarantia_St_ed" /></bpmn:startEvent><bpmn:businessRuleTask id="BaixaGarantia_Tk_Conferir" name="Conferir quitação integral da cota"><bpmn:documentation>[NORMA] Lei 11.795 art. 14 §5º II: liberar antes da quitação gera dever de indenizar o grupo.</bpmn:documentation><bpmn:incoming>Proc_BaixaGarantia_f1</bpmn:incoming><bpmn:outgoing>Proc_BaixaGarantia_f2</bpmn:outgoing></bpmn:businessRuleTask><bpmn:sendTask id="BaixaGarantia_Tk_Termo" name="Emitir termo de liberação / comandar baixa"><bpmn:incoming>Proc_BaixaGarantia_f2</bpmn:incoming><bpmn:outgoing>Proc_BaixaGarantia_f3</bpmn:outgoing></bpmn:sendTask><bpmn:task id="BaixaGarantia_Tk_Baixa" name="Baixar gravame / cancelar AF na matrícula"><bpmn:incoming>Proc_BaixaGarantia_f3</bpmn:incoming><bpmn:outgoing>Proc_BaixaGarantia_f4</bpmn:outgoing></bpmn:task><bpmn:task id="BaixaGarantia_Tk_Recebe" name="Receber documento liberado"><bpmn:incoming>Proc_BaixaGarantia_f4</bpmn:incoming><bpmn:outgoing>Proc_BaixaGarantia_f5</bpmn:outgoing></bpmn:task><bpmn:endEvent id="BaixaGarantia_En" name="Garantia baixada"><bpmn:incoming>Proc_BaixaGarantia_f5</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Proc_BaixaGarantia_f1" name="" sourceRef="BaixaGarantia_St" targetRef="BaixaGarantia_Tk_Conferir" /><bpmn:sequenceFlow id="Proc_BaixaGarantia_f2" name="" sourceRef="BaixaGarantia_Tk_Conferir" targetRef="BaixaGarantia_Tk_Termo" /><bpmn:sequenceFlow id="Proc_BaixaGarantia_f3" name="" sourceRef="BaixaGarantia_Tk_Termo" targetRef="BaixaGarantia_Tk_Baixa" /><bpmn:sequenceFlow id="Proc_BaixaGarantia_f4" name="" sourceRef="BaixaGarantia_Tk_Baixa" targetRef="BaixaGarantia_Tk_Recebe" /><bpmn:sequenceFlow id="Proc_BaixaGarantia_f5" name="" sourceRef="BaixaGarantia_Tk_Recebe" targetRef="BaixaGarantia_En" /></bpmn:process><bpmn:process id="Proc_Encerramento" name="Encerramento do grupo com crédito não utilizado" isExecutable="false"><bpmn:laneSet id="Proc_Encerramento_ls"><bpmn:lane id="Proc_Encerramento_L_adm" name="Administradora"><bpmn:flowNodeRef>Encerramento_St</bpmn:flowNodeRef><bpmn:flowNodeRef>Encerramento_Tk_Comunicar</bpmn:flowNodeRef><bpmn:flowNodeRef>Encerramento_Gw_Evt</bpmn:flowNodeRef><bpmn:flowNodeRef>Encerramento_Ev_Prazo</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_Encerramento_L_cons" name="Consorciado"><bpmn:flowNodeRef>Encerramento_Ev_Resp</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_Encerramento_L_tes" name="Tesouraria"><bpmn:flowNodeRef>Encerramento_Tk_Pagar</bpmn:flowNodeRef><bpmn:flowNodeRef>Encerramento_Tk_NP</bpmn:flowNodeRef><bpmn:flowNodeRef>Encerramento_En</bpmn:flowNodeRef><bpmn:flowNodeRef>Encerramento_En_NP</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Encerramento_St" name="Última AGO de contemplação"><bpmn:outgoing>Proc_Encerramento_f1</bpmn:outgoing><bpmn:signalEventDefinition id="Encerramento_St_ed" /></bpmn:startEvent><bpmn:sendTask id="Encerramento_Tk_Comunicar" name="Comunicar crédito disponível em espécie (≤ 60 dias)"><bpmn:documentation>Lei 11.795 art. 31; comunicação com controle de recebimento (Res. 285 art. 36).</bpmn:documentation><bpmn:incoming>Proc_Encerramento_f1</bpmn:incoming><bpmn:outgoing>Proc_Encerramento_f2</bpmn:outgoing></bpmn:sendTask><bpmn:eventBasedGateway id="Encerramento_Gw_Evt" name=""><bpmn:incoming>Proc_Encerramento_f2</bpmn:incoming><bpmn:outgoing>Proc_Encerramento_f3</bpmn:outgoing><bpmn:outgoing>Proc_Encerramento_f4</bpmn:outgoing></bpmn:eventBasedGateway><bpmn:intermediateCatchEvent id="Encerramento_Ev_Resp" name="Consorciado solicita o crédito"><bpmn:incoming>Proc_Encerramento_f3</bpmn:incoming><bpmn:outgoing>Proc_Encerramento_f5</bpmn:outgoing><bpmn:messageEventDefinition id="Encerramento_Ev_Resp_ed" /></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="Encerramento_Ev_Prazo" name="Prazo de encerramento (≤ 120 dias da última AGO)"><