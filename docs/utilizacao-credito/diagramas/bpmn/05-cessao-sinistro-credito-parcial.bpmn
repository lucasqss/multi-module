<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Complementares" targetNamespace="http://bpmn.io/schema/bpmn" exporter="gerar_bpmn.py" exporterVersion="1.0"><bpmn:collaboration id="Defs_Complementares_collab"><bpmn:participant id="Proc_Cessao_part" name="Cessão de cota contemplada" processRef="Proc_Cessao" /><bpmn:participant id="Proc_Sinistro_part" name="Óbito ou sinistro do titular contemplado" processRef="Proc_Sinistro" /><bpmn:participant id="Proc_CreditoParcial_part" name="Crédito parcial do contemplado excluído (RES_285)" processRef="Proc_CreditoParcial" /></bpmn:collaboration><bpmn:process id="Proc_Cessao" name="Cessão de cota contemplada" isExecutable="false"><bpmn:documentation>Lei 11.795 art. 13 (anuência prévia); Res. 285 art. 2º XIV-e e art. 3º §3º (capacidade do cessionário, evidência).</bpmn:documentation><bpmn:laneSet id="Proc_Cessao_ls"><bpmn:lane id="Proc_Cessao_L_ced" name="Cedente"><bpmn:flowNodeRef>Cessao_St</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_Cessao_L_ces" name="Cessionário"><bpmn:flowNodeRef>Cessao_Tk_Docs</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_Cessao_L_adm" name="Administradora · Crédito, PLD e Formalização"><bpmn:flowNodeRef>Cessao_Tk_Analise</bpmn:flowNodeRef><bpmn:flowNodeRef>Cessao_Gw_Anuencia</bpmn:flowNodeRef><bpmn:flowNodeRef>Cessao_En_Rep</bpmn:flowNodeRef><bpmn:flowNodeRef>Cessao_Gw_Usado</bpmn:flowNodeRef><bpmn:flowNodeRef>Cessao_Tk_Cancelar</bpmn:flowNodeRef><bpmn:flowNodeRef>Cessao_Tk_Garantia</bpmn:flowNodeRef><bpmn:flowNodeRef>Cessao_Gw_M</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_Cessao_L_grp" name="Gestão do grupo"><bpmn:flowNodeRef>Cessao_Tk_Titular</bpmn:flowNodeRef><bpmn:flowNodeRef>Cessao_En</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Cessao_St" name="Pedido de cessão"><bpmn:outgoing>Proc_Cessao_f1</bpmn:outgoing><bpmn:messageEventDefinition id="Cessao_St_ed" /></bpmn:startEvent><bpmn:userTask id="Cessao_Tk_Docs" name="Enviar documentos e renda do cessionário"><bpmn:incoming>Proc_Cessao_f1</bpmn:incoming><bpmn:outgoing>Proc_Cessao_f2</bpmn:outgoing></bpmn:userTask><bpmn:businessRuleTask id="Cessao_Tk_Analise" name="Analisar capacidade e PLD do cessionário"><bpmn:documentation>Atenção a indícios de comercialização irregular de cota contemplada [PRÁTICA].</bpmn:documentation><bpmn:incoming>Proc_Cessao_f2</bpmn:incoming><bpmn:outgoing>Proc_Cessao_f3</bpmn:outgoing></bpmn:businessRuleTask><bpmn:exclusiveGateway id="Cessao_Gw_Anuencia" name="Anuência concedida?"><bpmn:incoming>Proc_Cessao_f3</bpmn:incoming><bpmn:outgoing>Proc_Cessao_f4</bpmn:outgoing><bpmn:outgoing>Proc_Cessao_f5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="Cessao_En_Rep" name="Cessão recusada"><bpmn:incoming>Proc_Cessao_f4</bpmn:incoming></bpmn:endEvent><bpmn:exclusiveGateway id="Cessao_Gw_Usado" name="Crédito já utilizado?"><bpmn:incoming>Proc_Cessao_f5</bpmn:incoming><bpmn:outgoing>Proc_Cessao_f6</bpmn:outgoing><bpmn:outgoing>Proc_Cessao_f7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="Cessao_Tk_Cancelar" name="Cancelar solicitações em aberto e transferir o direito de uso"><bpmn:incoming>Proc_Cessao_f7</bpmn:incoming><bpmn:outgoing>Proc_Cessao_f9</bpmn:outgoing></bpmn:task><bpmn:userTask id="Cessao_Tk_Garantia" name="Obter anuência do garantidor ou substituir garantia"><bpmn:documentation>Saldo devedor e garantia passam ao cessionário.</bpmn:documentation><bpmn:incoming>Proc_Cessao_f6</bpmn:incoming><bpmn:outgoing>Proc_Cessao_f8</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Cessao_Gw_M" name=""><bpmn:incoming>Proc_Cessao_f8</bpmn:incoming><bpmn:incoming>Proc_Cessao_f9</bpmn:incoming><bpmn:outgoing>Proc_Cessao_f10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="Cessao_Tk_Titular" name="Registrar troca de titularidade"><bpmn:incoming>Proc_Cessao_f10</bpmn:incoming><bpmn:outgoing>Proc_Cessao_f11</bpmn:outgoing></bpmn:task><bpmn:endEvent id="Cessao_En" name="Cessão concluída"><bpmn:incoming>Proc_Cessao_f11</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Proc_Cessao_f1" name="" sourceRef="Cessao_St" targetRef="Cessao_Tk_Docs" /><bpmn:sequenceFlow id="Proc_Cessao_f2" name="" sourceRef="Cessao_Tk_Docs" targetRef="Cessao_Tk_Analise" /><bpmn:sequenceFlow id="Proc_Cessao_f3" name="" sourceRef="Cessao_Tk_Analise" targetRef="Cessao_Gw_Anuencia" /><bpmn:sequenceFlow id="Proc_Cessao_f4" name="não" sourceRef="Cessao_Gw_Anuencia" targetRef="Cessao_En_Rep" /><bpmn:sequenceFlow id="Proc_Cessao_f5" name="sim" sourceRef="Cessao_Gw_Anuencia" targetRef="Cessao_Gw_Usado" /><bpmn:sequenceFlow id="Proc_Cessao_f6" name="sim" sourceRef="Cessao_Gw_Usado" targetRef="Cessao_Tk_Garantia" /><bpmn:sequenceFlow id="Proc_Cessao_f7" name="não" sourceRef="Cessao_Gw_Usado" targetRef="Cessao_Tk_Cancelar" /><bpmn:sequenceFlow id="Proc_Cessao_f8" name="" sourceRef="Cessao_Tk_Garantia" targetRef="Cessao_Gw_M" /><bpmn:sequenceFlow id="Proc_Cessao_f9" name="" sourceRef="Cessao_Tk_Cancelar" targetRef="Cessao_Gw_M" /><bpmn:sequenceFlow id="Proc_Cessao_f10" name="" sourceRef="Cessao_Gw_M" targetRef="Cessao_Tk_Titular" /><bpmn:sequenceFlow id="Proc_Cessao_f11" name="" sourceRef="Cessao_Tk_Titular" targetRef="Cessao_En" /></bpmn:process><bpmn:process id="Proc_Sinistro" name="Óbito ou sinistro do titular contemplado" isExecutable="false"><bpmn:documentation>Res. 285 arts. 14 e 29.</bpmn:documentation><bpmn:laneSet id="Proc_Sinistro_ls"><bpmn:lane id="Proc_Sinistro_L_ben" name="Beneficiários / espólio"><bpmn:flowNodeRef>Sinistro_St</bpmn:flowNodeRef><bpmn:flowNodeRef>Sinistro_Tk_Sucessores</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_Sinistro_L_adm" name="Administradora"><bpmn:flowNodeRef>Sinistro_Tk_Suspender</bpmn:flowNodeRef><bpmn:flowNodeRef>Sinistro_Tk_Abrir</bpmn:flowNodeRef><bpmn:flowNodeRef>Sinistro_Gw_Ind</bpmn:flowNodeRef><bpmn:flowNodeRef>Sinistro_Tk_Retomar</bpmn:flowNodeRef><bpmn:flowNodeRef>Sinistro_En_Neg</bpmn:flowNodeRef><bpmn:flowNodeRef>Sinistro_Gw_Usado</bpmn:flowNodeRef><bpmn:flowNodeRef>Sinistro_Tk_Baixa</bpmn:flowNodeRef><bpmn:flowNodeRef>Sinistro_En</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_Sinistro_L_seg" name="Seguradora"><bpmn:flowNodeRef>Sinistro_Tk_Regular</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_Sinistro_L_grp" name="Gestão do grupo"><bpmn:flowNodeRef>Sinistro_Tk_Amortizar</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Sinistro_St" name="Aviso de óbito / sinistro"><bpmn:outgoing>Proc_Sinistro_f1</bpmn:outgoing><bpmn:messageEventDefinition id="Sinistro_St_ed" /></bpmn:startEvent><bpmn:task id="Sinistro_Tk_Suspender" name="Suspender pagamentos pendentes da cota"><bpmn:incoming>Proc_Sinistro_f1</bpmn:incoming><bpmn:outgoing>Proc_Sinistro_f2</bpmn:outgoing></bpmn:task><bpmn:sendTask id="Sinistro_Tk_Abrir" name="Abrir sinistro com documentos"><bpmn:incoming>Proc_Sinistro_f2</bpmn:incoming><bpmn:outgoing>Proc_Sinistro_f3</bpmn:outgoing></bpmn:sendTask><bpmn:task id="Sinistro_Tk_Regular" name="Regular sinistro"><bpmn:incoming>Proc_Sinistro_f3</bpmn:incoming><bpmn:outgoing>Proc_Sinistro_f4</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="Sinistro_Gw_Ind" name="Indenizado?"><bpmn:incoming>Proc_Sinistro_f4</bpmn:incoming><bpmn:outgoing>Proc_Sinistro_f5</bpmn:outgoing><bpmn:outgoing>Proc_Sinistro_f6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="Sinistro_Tk_Retomar" name="Retomar fluxo com os sucessores"><bpmn:incoming>Proc_Sinistro_f6</bpmn:incoming><bpmn:outgoing>Proc_Sinistro_f7</bpmn:outgoing></bpmn:task><bpmn:endEvent id="Sinistro_En_Neg" name="Sinistro negado"><bpmn:incoming>Proc_Sinistro_f7</bpmn:incoming></bpmn:endEvent><bpmn:task id="Sinistro_Tk_Amortizar" name="Amortizar / quitar saldo com a indenização"><bpmn:incoming>Proc_Sinistro_f5</bpmn:incoming><bpmn:outgoing>Proc_Sinistro_f8</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="Sinistro_Gw_Usado" name="Crédito já utilizado?"><bpmn:incoming>Proc_Sinistro_f8</bpmn:incoming><bpmn:outgoing>Proc_Sinistro_f9</bpmn:outgoing><bpmn:outgoing>Proc_Sinistro_f10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="Sinistro_Tk_Baixa" name="Baixar garantia e pagar sobra da indenização aos beneficiários"><bpmn:documentation>Res. 285 art. 29.</bpmn:documentation><bpmn:incoming>Proc_Sinistro_f9</bpmn:incoming><bpmn:outgoing>Proc_Sinistro_f11</bpmn:outgoing></bpmn:task><bpmn:userTask id="Sinistro_Tk_Sucessores" name="Manter crédito para os sucessores (alvará/inventário)"><bpmn:incoming>Proc_Sinistro_f10</bpmn:incoming><bpmn:outgoing>Proc_Sinistro_f12</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="Sinistro_En" name="Sinistro encerrado"><bpmn:incoming>Proc_Sinistro_f11</bpmn:incoming><bpmn:incoming>Proc_Sinistro_f12</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Proc_Sinistro_f1" name="" sourceRef="Sinistro_St" targetRef="Sinistro_Tk_Suspender" /><bpmn:sequenceFlow id="Proc_Sinistro_f2" name="" sourceRef="Sinistro_Tk_Suspender" targetRef="Sinistro_Tk_Abrir" /><bpmn:sequenceFlow id="Proc_Sinistro_f3" name="" sourceRef="Sinistro_Tk_Abrir" targetRef="Sinistro_Tk_Regular" /><bpmn:sequenceFlow id="Proc_Sinistro_f4" name="" sourceRef="Sinistro_Tk_Regular" targetRef="Sinistro_Gw_Ind" /><bpmn:sequenceFlow id="Proc_Sinistro_f5" name="sim" sourceRef="Sinistro_Gw_Ind" targetRef="Sinistro_Tk_Amortizar" /><bpmn:sequenceFlow id="Proc_Sinistro_f6" name="não" sourceRef="Sinistro_Gw_Ind" targetRef="Sinistro_Tk_Retomar" /><bpmn:sequenceFlow id="Proc_Sinistro_f7" name="" sourceRef="Sinistro_Tk_Retomar" targetRef="Sinistro_En_Neg" /><bpmn:sequenceFlow id="Proc_Sinistro_f8" name="" sourceRef="Sinistro_Tk_Amortizar" targetRef="Sinistro_Gw_Usado" /><bpmn:sequenceFlow id="Proc_Sinistro_f9" name="sim" sourceRef="Sinistro_Gw_Usado" targetRef="Sinistro_Tk_Baixa" /><bpmn:sequenceFlow id="Proc_Sinistro_f10" name="não" sourceRef="Sinistro_Gw_Usado" targetRef="Sinistro_Tk_Sucessores" /><bpmn:sequenceFlow id="Proc_Sinistro_f11" name="" sourceRef="Sinistro_Tk_Baixa" targetRef="Sinistro_En" /><bpmn:sequenceFlow id="Proc_Sinistro_f12" name="" sourceRef="Sinistro_Tk_Sucessores" targetRef="Sinistro_En" /></bpmn:process><bpmn:process id="Proc_CreditoParcial" name="Crédito parcial do contemplado excluído (RES_285)" isExecutable="false"><bpmn:documentation>Res. 285 arts. 32, 32-A e 33. Vedado se o crédito já foi utilizado na aquisição (art. 32 p.u.).</bpmn:documentation><bpmn:laneSet id="Proc_CreditoParcial_ls"><bpmn:lane id="Proc_CreditoParcial_L_grp" name="Gestão do grupo"><bpmn:flowNodeRef>CreditoParcial_St</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_CreditoParcial_L_adm" name="Administradora"><bpmn:flowNodeRef>CreditoParcial_Gw_Usado</bpmn:flowNodeRef><bpmn:flowNodeRef>CreditoParcial_En_Ved</bpmn:flowNodeRef><bpmn:flowNodeRef>CreditoParcial_Tk_Calcular</bpmn:flowNodeRef><bpmn:flowNodeRef>CreditoParcial_Tk_Comunicar</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_CreditoParcial_L_exc" name="Excluído"><bpmn:flowNodeRef>CreditoParcial_Tk_Conta</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Proc_CreditoParcial_L_tes" name="Tesouraria"><bpmn:flowNodeRef>CreditoParcial_Tk_Pagar</bpmn:flowNodeRef><bpmn:flowNodeRef>CreditoParcial_En</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="CreditoParcial_St" name="Cota contemplada excluída"><bpmn:outgoing>Proc_CreditoParcial_f1</bpmn:outgoing><bpmn:messageEventDefinition id="CreditoParcial_St_ed" /></bpmn:startEvent><bpmn:exclusiveGateway id="CreditoParcial_Gw_Usado" name="Crédito já utilizado?"><bpmn:incoming>Proc_CreditoParcial_f1</bpmn:incoming><bpmn:outgoing>Proc_CreditoParcial_f2</bpmn:outgoing><bpmn:outgoing>Proc_CreditoParcial_f3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="CreditoParcial_En_Ved" name="Exclusão vedada — informar gestão do grupo"><bpmn:incoming>Proc_CreditoParcial_f2</bpmn:incoming></bpmn:endEvent><bpmn:businessRuleTask id="CreditoParcial_Tk_Calcular" name="Calcular crédito parcial e devolver diferença ao fundo comum"><bpmn:documentation>% amortizado × crédito atualizado − multa (art. 32-A) − pendências.</bpmn:documentation><bpmn:incoming>Proc_CreditoParcial_f3</bpmn:incoming><bpmn:outgoing>Proc_CreditoParcial_f4</bpmn:outgoing></bpmn:businessRuleTask><bpmn:sendTask id="CreditoParcial_Tk_Comunicar" name="Comunicar com controle de recebimento e pedir conta própria"><bpmn:incoming>Proc_CreditoParcial_f4</bpmn:incoming><bpmn:outgoing>Proc_CreditoParcial_f5</bpmn:outgoing></bpmn:sendTask><bpmn:userTask id="CreditoParcial_Tk_Conta" name="Informar conta própria"><bpmn:incoming>Proc_CreditoParcial_f5</bpmn:incoming><bpmn:outgoing>Proc_CreditoParcial_f6</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="CreditoParcial_Tk_Pagar" name="Pagar crédito parcial"><bpmn:incoming>Proc_CreditoParcial_f6</bpmn:incoming><bpmn:outgoing>Proc_CreditoParcial_f7</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="CreditoParcial_En" name="Crédito parcial pago"><bpmn:incoming>Proc_CreditoParcial_f7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Proc_CreditoParcial_f1" name="" sourceRef="CreditoParcial_St" targetRef="CreditoParcial_Gw_Usado" /><bpmn:sequenceFlow id="Proc_CreditoParcial_f2" name="sim" sourceRef="CreditoParcial_Gw_Usado" targetRef="CreditoParcial_En_Ved" /><bpmn:sequenceFlow id="Proc_CreditoParcial_f3" name="não" sourceRef="CreditoParcial_Gw_Usado" targetRef="CreditoParcial_Tk_Calcular" /><bpmn:sequenceFlow id="Proc_CreditoParcial_f4" name="" sourceRef="CreditoParcial_Tk_Calcular" targetRef="CreditoParcial_Tk_Comunicar" /><bpmn:sequenceFlow id="Proc_CreditoParcial_f5" name="" sourceRef="CreditoParcial_Tk_Comunicar" targetRef="CreditoParcial_Tk_Conta" /><bpmn:sequenceFlow id="Proc_CreditoParcial_f6" name="" sourceRef="CreditoParcial_Tk_Conta" targetRef="CreditoParcial_Tk_Pagar" /><bpmn:sequenceFlow id="Proc_CreditoParcial_f7" name="" sourceRef="CreditoParci