<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>multi-module-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!-- Integrações de saída com sistemas externos, um pacote por sistema (integracoes.<sistema>). Cada pacote
         implementa ports do domínio do processo-core e converte o modelo do sistema externo para o do domínio
         (anticorrupção): DTOs, códigos e erros externos não passam daqui. O core não depende deste módulo; quem o
         liga é o processo-app. Sistema com ciclo de vida próprio ou descartável ganha módulo próprio (veja a
         impressao). -->
    <artifactId>integracoes</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>processo-core</artifactId>
        </dependency>
        <!-- Quando o cliente simulado virar chamada real:
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-jackson</artifactId>
        </dependency>
        -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
