<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>modelo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!-- Módulo da aplicação: o único com quarkus-maven-plugin e application.properties.
         Expõe o core via REST, gera o executável em target/quarkus-app/ e, por ser o último do reactor,
         junta a cobertura de todos os módulos no target/ da raiz. -->
    <artifactId>modelo-app</artifactId>

    <dependencies>
        <!-- Módulo interno: sem versão, gerenciada no POM pai.
             Declare aqui DIRETAMENTE todo módulo interno usado, mesmo que já venha por transitividade:
             o relatório de cobertura agregado só inclui as dependências diretas deste pom. -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>modelo-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <!-- Cobertura agregada (este módulo + dependências diretas) em target/site/jacoco-aggregate/ da raiz.
                 Fica no app, e não no POM pai, porque o pai é construído antes de qualquer teste rodar. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <includeCurrentProject>true</includeCurrentProject>
                            <outputDirectory>${relatorios.dir}/site/jacoco-aggregate</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
