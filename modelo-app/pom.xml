<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>modelo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!-- Módulo da aplicação: o único com quarkus-maven-plugin e application.properties.
         Expõe o core via REST e gera o ÚNICO artefato de deploy, target/modelo.jar (uber-jar com todos os
         módulos; veja application.properties). Também guarda as regras de arquitetura (ArchUnit) e gera a
         cobertura agregada, porque é o único módulo que enxerga todos os outros. -->
    <artifactId>modelo-app</artifactId>

    <dependencies>
        <!-- Módulo interno: sem versão, gerenciada no POM pai. Todo módulo precisa chegar até aqui (direta ou
             transitivamente): é o que o coloca no jar, nas regras do ArchUnit e na cobertura. -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>modelo-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <!-- Cobertura agregada de TODOS os módulos em target/site/jacoco-aggregate/ (o que o Sonar lê).
                 Roda aqui porque o app depende de todos os módulos e é o último do reactor; o POM pai é
                 construído antes de qualquer teste. Usa a tarefa Ant do JaCoCo, e não o report-aggregate, porque
                 este só procura os .exec dentro da pasta de cada módulo, e o build usa um target/ único.
                 Pega qualquer módulo por convenção de diretório: target/*/classes e */src/main/java. -->
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>cobertura-agregada</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <taskdef uri="antlib:org.jacoco.ant" resource="org/jacoco/ant/antlib.xml"
                                         classpathref="maven.plugin.classpath"/>
                                <jacoco:report xmlns:jacoco="antlib:org.jacoco.ant">
                                    <executiondata>
                                        <fileset dir="${target.raiz}" includes="*/jacoco.exec"/>
                                    </executiondata>
                                    <structure name="${project.parent.artifactId}">
                                        <classfiles>
                                            <fileset dir="${target.raiz}" includes="*/classes/**/*.class"/>
                                        </classfiles>
                                        <sourcefiles encoding="${project.build.sourceEncoding}">
                                            <dirset dir="${maven.multiModuleProjectDirectory}" includes="*/src/main/java"/>
                                        </sourcefiles>
                                    </structure>
                                    <html destdir="${target.raiz}/site/jacoco-aggregate"/>
                                    <xml destfile="${target.raiz}/site/jacoco-aggregate/jacoco.xml"/>
                                </jacoco:report>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
