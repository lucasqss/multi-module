<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>modelo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!-- Módulo técnico, sem código: junta a cobertura de todos os módulos num único relatório JaCoCo em
         target/site/jacoco-aggregate/ da RAIZ (o que o Sonar lê).

         Por que um módulo e não o POM pai? O pai é construído PRIMEIRO no reactor, antes de qualquer teste
         rodar; e o report-aggregate só enxerga os módulos dos quais o projeto depende. Este módulo depende de
         todos, então é construído por último.

         Ao criar um módulo novo, adicione-o como dependência aqui, senão ele fica fora da cobertura. -->
    <artifactId>modelo-cobertura</artifactId>
    <packaging>pom</packaging>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>modelo-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>modelo-app</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${relatorios.dir}/site/jacoco-aggregate</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
