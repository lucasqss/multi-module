<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- POM pai: agrega os módulos e centraliza versões e plugins. Não tem código.
         Para adicionar um módulo, veja docs/adicionando-modulos.md -->
    <groupId>com.example</groupId>
    <artifactId>modelo-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!-- A ordem aqui não importa: o reactor ordena pelas dependências entre os módulos -->
    <modules>
        <module>modelo-core</module>
        <module>modelo-app</module>
        <!-- Técnico: junta a cobertura de todos os módulos (não é exemplo; veja o pom dele) -->
        <module>modelo-cobertura</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.33.4</quarkus.platform.version>
        <compiler-plugin.version>3.14.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.3</surefire-plugin.version>
        <enforcer-plugin.version>3.6.2</enforcer-plugin.version>
        <jandex-plugin.version>3.3.1</jandex-plugin.version>
        <jacoco-plugin.version>0.8.15</jacoco-plugin.version>

        <!-- target/ da RAIZ do repositório, onde ficam os relatórios de teste e cobertura de todos os módulos.
             maven.multiModuleProjectDirectory é a pasta que contém o .mvn/ (por isso ele não pode ser removido). -->
        <relatorios.dir>${maven.multiModuleProjectDirectory}/target</relatorios.dir>
        <!-- Preenchido pelo jacoco:prepare-agent; o valor vazio evita erro se o JaCoCo for pulado -->
        <argLine/>

        <!-- Onde o Sonar procura resultados de testes e cobertura -->
        <sonar.junit.reportPaths>${relatorios.dir}/surefire-reports,${relatorios.dir}/failsafe-reports</sonar.junit.reportPaths>
        <sonar.coverage.jacoco.xmlReportPaths>${relatorios.dir}/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOM do Quarkus: os módulos declaram dependências do Quarkus (e JUnit, RestAssured...) sem versão -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Módulos internos: a versão fica só aqui, os módulos declaram sem <version> -->
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>modelo-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>modelo-app</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Só o módulo que gera o executável (modelo-app) ativa este plugin -->
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                    <extensions>true</extensions>
                    <executions>
                        <execution>
                            <goals>
                                <goal>build</goal>
                                <goal>generate-code</goal>
                                <goal>generate-code-tests</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- Gera META-INF/jandex.idx: sem ele o Quarkus não enxerga os beans CDI de um módulo-biblioteca -->
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>${jandex-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>make-index</id>
                            <goals>
                                <goal>jandex</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-plugin.version}</version>
                </plugin>
                <!-- @QuarkusIntegrationTest (*IT) roda contra o artefato empacotado, na fase verify -->
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <reportsDirectory>${relatorios.dir}/failsafe-reports</reportsDirectory>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- Plugins herdados por TODOS os módulos -->
        <plugins>
            <!-- Falha cedo, com mensagem clara, se o JDK ou o Maven forem antigos demais -->
            <plugin>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.6,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <!-- Mantém o nome dos parâmetros no bytecode (usado pelo REST para @PathParam/@QueryParam sem valor) -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!-- Agente de cobertura em todos os módulos: grava <módulo>/target/jacoco.exec durante os testes -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <!-- Todos os módulos gravam no target/ da raiz (nomes TEST-<classe>.xml não colidem) -->
                    <reportsDirectory>${relatorios.dir}/surefire-reports</reportsDirectory>
                    <!-- @{argLine} (avaliado tarde) recebe o agente do JaCoCo -->
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
