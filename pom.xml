<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- POM pai: agrega os módulos e centraliza versões e plugins. Não tem código.
         Os módulos existem para separar o design e limitar o acoplamento (Maven + ArchUnit); a entrega é
         UM jar (biblioteca-app) e o build usa UM target/, na raiz. Para adicionar um módulo, veja
         docs/adicionando-modulos.md -->
    <groupId>com.example</groupId>
    <artifactId>multi-module-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!-- A ordem aqui não importa: o reactor ordena pelas dependências entre os módulos -->
    <modules>
        <module>jpa-core</module>
        <module>string-generator</module>
        <module>biblioteca-command</module>
        <module>biblioteca-query</module>
        <module>biblioteca-app</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.33.4</quarkus.platform.version>
        <compiler-plugin.version>3.14.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.3</surefire-plugin.version>
        <enforcer-plugin.version>3.6.2</enforcer-plugin.version>
        <jandex-plugin.version>3.3.1</jandex-plugin.version>
        <resources-plugin.version>3.3.1</resources-plugin.version>
        <jacoco-plugin.version>0.8.15</jacoco-plugin.version>
        <clean-plugin.version>3.5.0</clean-plugin.version>
        <archunit.version>1.5.1</archunit.version>

        <!-- O único target/ do build, na RAIZ do repositório: cada módulo compila em target/<artifactId>/ e os
             relatórios de teste/cobertura e o jar final ficam direto em target/.
             maven.multiModuleProjectDirectory é a pasta que contém o .mvn/ (por isso ele não pode ser removido). -->
        <target.raiz>${maven.multiModuleProjectDirectory}/target</target.raiz>
        <!-- Preenchido pelo jacoco:prepare-agent; o valor vazio evita erro se o JaCoCo for pulado -->
        <argLine/>

        <!-- Onde o Sonar procura resultados de testes e cobertura. A cobertura é um relatório por módulo
             (target/site/jacoco/<artifactId>/); herdada, a propriedade aponta cada módulo para o seu. -->
        <sonar.junit.reportPaths>${target.raiz}/surefire-reports,${target.raiz}/failsafe-reports</sonar.junit.reportPaths>
        <sonar.coverage.jacoco.xmlReportPaths>${target.raiz}/site/jacoco/${project.artifactId}/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOM do Quarkus: os módulos declaram dependências do Quarkus (e JUnit, RestAssured...) sem versão -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Testes de arquitetura: regras entre módulos (biblioteca-app) e dentro do command -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <!-- Módulos internos: a versão fica só aqui, os módulos declaram sem <version> -->
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>jpa-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>string-generator</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>biblioteca-command</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>biblioteca-query</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- Nada de <módulo>/target/: tudo vai para target/<artifactId>/ na raiz -->
        <directory>${target.raiz}/${project.artifactId}</directory>

        <pluginManagement>
            <plugins>
                <!-- Só o módulo que gera o executável (biblioteca-app) ativa este plugin -->
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                    <extensions>true</extensions>
                    <executions>
                        <execution>
                            <goals>
                                <goal>build</goal>
                                <goal>generate-code</goal>
                                <goal>generate-code-tests</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- Gera META-INF/jandex.idx: sem ele o Quarkus não enxerga os beans CDI de um módulo-biblioteca -->
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>${jandex-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>make-index</id>
                            <goals>
                                <goal>jandex</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-plugin.version}</version>
                </plugin>
                <!-- @QuarkusIntegrationTest (*IT): testes ponta a ponta contra o jar fechado, na fase verify.
                     Ficam FORA da cobertura: nenhum agente do JaCoCo vai para o processo do jar. -->
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <reportsDirectory>${target.raiz}/failsafe-reports</reportsDirectory>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <!-- Log do jar iniciado pelo @QuarkusIntegrationTest; o padrão criaria <módulo>/target/ -->
                            <quarkus.log.file.path>${project.build.directory}/quarkus.log</quarkus.log.file.path>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- Plugins herdados por TODOS os módulos -->
        <plugins>
            <!-- "mvn clean" na raiz apaga o target/ inteiro (relatórios e jar incluídos). Não é herdado: se fosse,
                 cada módulo apagaria o que os anteriores já construíram no mesmo build. -->
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>${clean-plugin.version}</version>
                <inherited>false</inherited>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${target.raiz}</directory>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <!-- Falha cedo, com mensagem clara, se o JDK ou o Maven forem antigos demais -->
            <plugin>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.6,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <!-- Mantém o nome dos parâmetros no bytecode (usado pelo REST para @PathParam/@QueryParam sem valor) -->
                    <parameters>true</parameters>
                    <!-- Hibernate Processor: gera o metamodel (LivroEntity_) e as implementações dos
                         repositórios Jakarta Data, validando o HQL de @Query em tempo de compilação -->
                    <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.hibernate.orm</groupId>
                            <artifactId>hibernate-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <!-- Todos os módulos gravam no target/ da raiz (nomes TEST-<classe>.xml não colidem) -->
                    <reportsDirectory>${target.raiz}/surefire-reports</reportsDirectory>
                    <!-- @{argLine} (avaliado tarde) recebe o agente do JaCoCo -->
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Cobertura dos testes unitários, um relatório por módulo: o agente grava
                 target/<artifactId>/jacoco.exec e o report gera target/site/jacoco/<artifactId>/ (jacoco.xml para o
                 Sonar, index.html para pessoas). Cada módulo é medido pelos próprios testes; os *IT não entram.
                 Declarado DEPOIS do surefire: o report também roda na fase test e precisa vir depois dos testes.
                 Módulo sem testes (ou sem classes) não gera relatório. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${target.raiz}/site/jacoco/${project.artifactId}</outputDirectory>
                            <!-- Metamodel e repositórios gerados pelo Hibernate Processor (LivroEntity_, Livros_) -->
                            <excludes>
                                <exclude>**/*_.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
